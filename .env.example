# Postgres (Neon). Provisioned by the Vercel <-> Neon integration; `vercel env pull .env.local` fills it locally.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs the HttpOnly session cookie (HS256 JWT). 48+ random bytes, base64url.
SESSION_SECRET=

# Protects /api/cron/monitor. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional RPC overrides (public Mezo endpoints are used by default)
# NEXT_PUBLIC_MEZO_TESTNET_RPC=https://rpc.test.mezo.org
# NEXT_PUBLIC_MEZO_MAINNET_RPC=https://mezo.drpc.org

# Optional: canonical public URL used for OG tags (defaults to the request host)
# NEXT_PUBLIC_SITE_URL=https://musd-rescue.vercel.app

# Optional: testnet key the server keeper uses to run Ready RescueGuard rescues (daily cron + "Ask the app keeper").
# It only pays gas and earns owner-set tips; it never holds user funds. Leave empty to rely on `npm run keeper`
# or visitors pressing "Run rescue now".
# KEEPER_PRIVATE_KEY=

# Scripts only (never read by the app):
#   .env.deployer           PRIVATE_KEY=... for npm run guard:deploy / wallets:fund (gitignored)
#   .env.e2e-wallets.json   generated test wallets for the browser e2e (gitignored)
# Paths, not secrets:
# DEPLOYER_ENV_FILE=C:/Users/you/Desktop/.env.txt   (file containing PRIVATE_KEY=...)
# TEST_WALLETS_FILE=/path/to/test-wallets.json
# E2E_BASE_URL=http://localhost:3000
